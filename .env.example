# =============================================================================
# Paypoint — environment variables
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# =============================================================================

# --- Supabase (Phase 0/1 — required now) -------------------------------------
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose; RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SERVER ONLY — never expose to the browser). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------------
# Public base URL used to build OAuth/email redirect URLs.
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Future phases — placeholders only, NOT used in Phase 0/1.
# =============================================================================

# --- Kora (payments + KYC/KYB) — Phases 3/4 ----------------------------------
# ONE secret key powers everything: Identity (CAC/BVN/bank lookups), charges,
# disbursements, and webhook signatures. From merchant.korapay.com -> Settings
# -> API Keys. Identity access must be requested first (dashboard -> Identity
# -> Request Access + the due-diligence form). Leave empty for the dev
# fallback: verification, checkout, and payouts are simulated end to end.
KORA_SECRET_KEY=

# --- Paypoint pricing (per successful payment) --------------------------------
# fee = min(amount * percent/100 + flat, cap), never exceeding the amount.
PAYPOINT_FEE_PERCENT=2
PAYPOINT_FEE_FLAT_KOBO=0
PAYPOINT_FEE_CAP_KOBO=200000

# --- Reconciliation sweep (GET /api/recon) ------------------------------------
# Shared secret for the scheduled sweep: Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# --- Meta WhatsApp Cloud API (OTP / notifications) — Phase 2 -----------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Brevo (transactional email) ---------------------------------------------
# API key from Brevo: SMTP & API -> API Keys (starts with "xkeysib-").
BREVO_API_KEY=
# Sender identity. EMAIL_FROM must be a verified sender/domain in Brevo.
EMAIL_FROM=hello@paypoint.co
EMAIL_FROM_NAME=Paypoint
